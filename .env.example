# DocSure - plantilla sin valores. Copiar a .env y completar.

# --- GitHub ---
GITHUB_USER=
GITHUB_REPO=
GITHUB_TOKEN=

# --- Vercel ---
VERCEL_TOKEN=

# --- Render ---
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_SERVICE_ID=

# --- Base de datos (Postgres) ---
RENDER_DB_ID=
DATABASE_URL=
DATABASE_URL_EXTERNAL=
TEST_DATABASE_URL=

# --- App ---
APP_URL=
SITE_URL=
SESSION_SECRET=
TOKEN_HMAC_SECRET=
ADMIN_TOKEN=

# --- Sello digital (X.509 autofirmado, PKCS#12 en base64) ---
SEAL_P12_BASE64=
SEAL_P12_PASSWORD=

# --- Resend (emails; sin clave los emails quedan en /admin/correos) ---
RESEND_API_KEY=
MAIL_FROM=

# Supabase
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
